<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.jarrunner</groupId>
  <artifactId>jr-maven-plugin</artifactId>
  <version>1.2.0-SNAPSHOT</version>
  <packaging>maven-plugin</packaging>

  <name>jr-maven-plugin</name>
  <description>Builds jr launcher exes for a Java app in the package phase: hashes the shaded jar, writes the jrc-json, stamps it with the icon and version into the jr exes bundled in this plugin, and optionally copies the result to an install directory.</description>
  <url>https://github.com/jarrunner/jr-maven-plugin</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>jarrunner</id>
      <name>Ivan Velikanov</name>
      <email>ivan.velikanov.dev@gmail.com</email>
      <url>https://github.com/jarrunner</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/jarrunner/jr-maven-plugin.git</connection>
    <developerConnection>scm:git:ssh://github.com:jarrunner/jr-maven-plugin.git</developerConnection>
    <url>https://github.com/jarrunner/jr-maven-plugin</url>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.version>3.9.16</maven.version>
    <plugin-tools.version>3.16.0</plugin-tools.version>
    <datahelper.version>2.0</datahelper.version>
    <jackson.version>2.22.2</jackson.version>
    <!-- The jr binaries this plugin bundles come from a jr release (https://github.com/jarrunner/jr/releases),
         downloaded at build time and checked against these SHA-256 sums, copied from that release's SHA256SUMS.
         The Windows exes are the jr-noicon-* builds: an app exe carries an icon only when its own pom names one.
         To move to a new jr release, change jr.release and the five sums together. -->
    <jr.release>1.2.1</jr.release>
    <jr.sha256.windows-x86_64>95044582f7fbc892b3e59ced4af1e448e0b3fa322b74474c770b4622b838f4f4</jr.sha256.windows-x86_64>
    <jr.sha256.windows-arm64>3b88382da8e0126fc45d9778809b40be30ba08bdb0a4d2dd2370bd1895ca5483</jr.sha256.windows-arm64>
    <jr.sha256.macos>324e728c2283242fbc1ed99a15501773e60259f0cff6fd2a7b12933d14b66e89</jr.sha256.macos>
    <jr.sha256.macos-arm64>d4588edb8d76856b21479deee618b8c0c2976ea04d49bf1dd49849d3aa6730be</jr.sha256.macos-arm64>
    <jr.sha256.macos-x86_64>4ce3e24efbef8d7de77e2590338130b5f7758c00d8052d84c7fb30681683850a</jr.sha256.macos-x86_64>
    <jr.download>https://github.com/jarrunner/jr/releases/download/v${jr.release}</jr.download>
    <jr.dist>${project.build.directory}/jr-bin</jr.dist>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${plugin-tools.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.datapotter</groupId>
      <artifactId>datapotter-datahelper-base</artifactId>
      <version>${datahelper.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.datapotter</groupId>
      <artifactId>datapotter-datahelper-annotations</artifactId>
      <version>${datahelper.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <!-- the .app zip keeps the executable bit, which java.util.zip cannot write -->
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.27.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${jr.dist}</directory>
        <targetPath>jarrunner/jr/maven</targetPath>
        <includes>
          <include>jr-windows-x86_64.exe</include>
          <include>jr-windows-arm64.exe</include>
        </includes>
      </resource>
      <resource>
        <directory>${jr.dist}</directory>
        <targetPath>jarrunner/jr/maven</targetPath>
        <includes>
          <include>jr-macos</include>
          <include>jr-macos-arm64</include>
          <include>jr-macos-x86_64</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>com.googlecode.maven-download-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>1.13.0</version>
        <configuration>
          <outputDirectory>${jr.dist}</outputDirectory>
          <failOnError>true</failOnError>
        </configuration>
        <executions>
          <execution>
            <id>jr-windows-x86_64</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <uri>${jr.download}/jr-noicon-windows-x86_64.exe</uri>
              <outputFileName>jr-windows-x86_64.exe</outputFileName>
              <sha256>${jr.sha256.windows-x86_64}</sha256>
            </configuration>
          </execution>
          <execution>
            <id>jr-windows-arm64</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <uri>${jr.download}/jr-noicon-windows-arm64.exe</uri>
              <outputFileName>jr-windows-arm64.exe</outputFileName>
              <sha256>${jr.sha256.windows-arm64}</sha256>
            </configuration>
          </execution>
          <execution>
            <id>jr-macos</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <uri>${jr.download}/jr-macos</uri>
              <sha256>${jr.sha256.macos}</sha256>
            </configuration>
          </execution>
          <execution>
            <id>jr-macos-arm64</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <uri>${jr.download}/jr-macos-arm64</uri>
              <sha256>${jr.sha256.macos-arm64}</sha256>
            </configuration>
          </execution>
          <execution>
            <id>jr-macos-x86_64</id>
            <phase>generate-resources</phase>
            <goals><goal>wget</goal></goals>
            <configuration>
              <uri>${jr.download}/jr-macos-x86_64</uri>
              <sha256>${jr.sha256.macos-x86_64}</sha256>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>io.github.datapotter</groupId>
              <artifactId>datapotter-datahelper-processor</artifactId>
              <version>${datahelper.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${plugin-tools.version}</version>
        <configuration>
          <goalPrefix>jr</goalPrefix>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- Release to Maven Central: Maven 3 only, never the default Maven 4 (under Maven 4 the
       central-publishing binding silently uploads nothing, and BUILD SUCCESS still prints):
         mvn clean deploy (with a Maven 3 mvn) -Dorg.name=jarrunner
       The build downloads the bundled jr binaries from the jr release named in jr.release. Confirm a release by fetching it from repo1.maven.org. -->
  <profiles>
    <profile>
      <id>release</id>
      <activation>
        <property><name>org.name</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <configuration>
              <excludeResources>true</excludeResources>
            </configuration>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <configuration>
              <doclint>none</doclint>
              <additionalOptions>--no-fonts</additionalOptions>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
            <configuration>
              <keyname>${org.gpg.keyname}</keyname>
              <passphrase>${org.gpg.passphrase}</passphrase>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.9.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>${org.publishing.server.id}</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
